# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will not be committed.
#
# Legend:
#   [runtime]    needed by the running app (set in Vercel for prod — see technical/07-deployment.md)
#   [seed-only]  only the local seed scripts use it; NOT set in Vercel
#   [migration]  only psql/migrations use it; NOT set in Vercel

# [runtime] OpenAI API key — the default provider for ALL AI: chat and the Ora
# agent (lib/aiProvider.ts), extraction, narration, embeddings (seed pipeline +
# runtime RAG query embeddings), and transcription (Whisper).
OPENAI_API_KEY=

# [runtime] Optional chat model override for Ora on OpenAI. Defaults to
# gpt-4o-mini (lib/openai.ts MODELS.chat); set for a quality or cost change
# without a deploy-blocking code edit. Embeddings stay on text-embedding-3-small
# regardless (canonical, must match the seed pool).
OPENAI_MODEL=

# [runtime] AI provider seam: "openai" (default) or "anthropic". The Anthropic
# path is kept as a switch-back option; it needs the two vars below.
AI_PROVIDER=

# [runtime, only if AI_PROVIDER=anthropic] Anthropic API key.
ANTHROPIC_API_KEY=

# [runtime, only if AI_PROVIDER=anthropic] Optional model override. Defaults to
# claude-opus-4-8; set claude-sonnet-4-6 for lower cost on high-volume turns.
ANTHROPIC_MODEL=

# [runtime] n8n feedback webhook (Exercise 18). The in-app FeedbackWidget POSTs
# { "message": "..." } here; n8n classifies it with an LLM and routes it. The
# widget renders nothing when this is unset, so it is safe to leave blank.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# [runtime] Supabase — project URL and the two API keys.
# Publishable key is browser-safe (RLS gates every query).
# Secret key is server-only — never import it into a Client Component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# [migration] Postgres connection strings, both pointing at the same Supabase
# project. App code uses @supabase/supabase-js (URL + keys above), never these,
# so they are NOT needed in the Vercel runtime — only for psql/migrations.
# DATABASE_URL is the pooled connection (port 6543); DIRECT_URL is the direct
# connection (port 5432), used by migrations.
DATABASE_URL=
DIRECT_URL=
