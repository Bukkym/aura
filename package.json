{
  "name": "aura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:places": "EMBED_ALLOW_RUNTIME=true tsx --env-file=.env.local scripts/seed-places.ts",
    "seed:users": "EMBED_ALLOW_RUNTIME=true tsx --env-file=.env.local scripts/seed-users.ts",
    "seed": "npm run seed:places && npm run seed:users",
    "migrate:json-to-db": "tsx --env-file=.env.local scripts/migrate-json-to-supabase.ts",
    "seed:requests": "tsx --env-file=.env.local scripts/seed-requests.ts",
    "seed:canon": "tsx --env-file=.env.local scripts/canon-replay.ts",
    "seed:canon:check": "tsx --env-file=.env.local scripts/canon-replay.ts --check",
    "smoke:match": "tsx --env-file=.env.local scripts/smoke-match.ts",
    "smoke:plan": "tsx --env-file=.env.local scripts/smoke-plan.ts",
    "smoke:plans": "tsx --env-file=.env.local scripts/smoke-plans.ts",
    "smoke:archetype": "tsx --env-file=.env.local scripts/smoke-archetype.ts",
    "sim:liquidity": "tsx --env-file=.env.local scripts/sim-liquidity.ts",
    "build:knowledge": "EMBED_ALLOW_RUNTIME=true tsx --env-file=.env.local scripts/build-knowledge-embeddings.ts",
    "smoke:ora": "EMBED_ALLOW_RUNTIME=true tsx --env-file=.env.local scripts/smoke-ora.ts",
    "smoke:ora-agent": "tsx --env-file=.env.local scripts/smoke-ora-agent.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lib-tests": "tsx scripts/check-lib-tests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "geist": "^1.3.1",
    "next": "^15.0.3",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
